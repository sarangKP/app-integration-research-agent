<script>
function el(tag, props, text) {
  const e = document.createElement(tag);
  if (props) Object.assign(e, props);
  if (text !== undefined) e.textContent = text;
  return e;
}

// --- Matrix filters (safe DOM option creation, no innerHTML) ---
(function matrixFilters() {
  const rows = Array.from(document.querySelectorAll('#matrixTable tbody tr'));
  const catSel = document.getElementById('catFilter');
  const accessSel = document.getElementById('accessFilter');
  const buildSel = document.getElementById('buildFilter');
  const search = document.getElementById('searchBox');

  function uniqueSorted(attr) {
    return Array.from(new Set(rows.map(r => r.dataset[attr]))).sort();
  }
  function addOptions(select, values) {
    values.forEach(v => select.appendChild(el('option', { value: v }, v)));
  }
  addOptions(catSel, uniqueSorted('category'));
  addOptions(accessSel, uniqueSorted('access'));
  addOptions(buildSel, uniqueSorted('build'));

  function apply() {
    const q = search.value.toLowerCase();
    rows.forEach(r => {
      const matches = (!catSel.value || r.dataset.category === catSel.value)
        && (!accessSel.value || r.dataset.access === accessSel.value)
        && (!buildSel.value || r.dataset.build === buildSel.value)
        && (!q || r.dataset.name.includes(q));
      r.style.display = matches ? '' : 'none';
    });
  }
  [catSel, accessSel, buildSel, search].forEach(e => e.addEventListener('input', apply));
})();
</script>
